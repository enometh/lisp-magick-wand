(in-package "CL-USER")

(defvar *mandala-magick-source-dir*
  (merge-pathnames "mandala-magick/" (translate-logical-pathname "EXTERN:")))
(defvar *mandala-magick-binary-dir* (binary-directory *mandala-magick-source-dir*))

(mk:defsystem :mandala-magick
  :source-pathname *mandala-magick-source-dir*
  :binary-pathname *mandala-magick-binary-dir*
  :source-extension "lisp"
  :depends-on ("magick")
  :components ("shrii"
	       "mandala-magick"
	       (:module "other"
		:components ("huet"))
	       ))
#+nil
(mk:oos :mandala-magick :load :compile-during-load t)
