(in-package "CL-USER")

(defvar *magick-source-dir*
  (merge-pathnames "lisp-magick-wand/" (translate-logical-pathname "EXTERN:")))
(defvar *magick-binary-dir* (binary-directory *magick-source-dir*))

(mk:defsystem :magick
  :source-pathname *magick-source-dir*
  :binary-pathname *magick-binary-dir*
  :source-extension "lisp"
  :components
  ((:file "packages")
   (:file "base"      :depends-on ("packages"))
   (:file "quantum"   :depends-on ("packages" "base"))
   (:file "types"     :depends-on ("packages" "base" "quantum"))
   (:file "option"    :depends-on ("packages" "base" "types"))
   (:file "enums"     :depends-on ("packages" "base" "option"))
   (:file "magick"    :depends-on ("packages" "base" "quantum" "types" "enums"))
   (:file "utils"     :depends-on ("packages" "magick")))

  :depends-on ("cffi"))

#+nil
(mk:oos :magick :load :compile-during-load t)
